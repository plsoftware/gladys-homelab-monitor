{
  "manifest_version": 1,
  "type": "device",
  "name": "Linux hosts (node_exporter)",
  "description": {
    "en": "Linux machines via node_exporter: CPU, memory, disks, temperatures, drive health, updates, alerts.",
    "fr": "Machines Linux via node_exporter : CPU, mémoire, disques, températures, santé disques, alertes."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/plsoftware/gladys-homelab-monitor:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/plsoftware/gladys-homelab-monitor/main/cover.png",
  "categories": [
    "network",
    "services"
  ],
  "transports": [
    "local"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Hosts",
        "fr": "Machines"
      },
      "description": {
        "en": "Install node_exporter on each machine (Debian/Ubuntu/Raspberry Pi OS/Proxmox: sudo apt install prometheus-node-exporter prometheus-node-exporter-collectors). It serves read-only metrics on port 9100. No Prometheus server is needed.",
        "fr": "Installez node_exporter sur chaque machine (Debian/Ubuntu/Raspberry Pi OS/Proxmox : sudo apt install prometheus-node-exporter prometheus-node-exporter-collectors). Il expose des métriques en lecture seule sur le port 9100. Aucun serveur Prometheus n'est nécessaire."
      }
    },
    {
      "key": "hosts",
      "type": "string",
      "required": true,
      "label": {
        "en": "Hosts",
        "fr": "Machines"
      },
      "description": {
        "en": "name=address, separated by commas, e.g. server1=192.168.1.10, nas=192.168.1.11:9100",
        "fr": "nom=adresse, séparés par des virgules, ex. serveur1=192.168.1.10, nas=192.168.1.11:9100"
      }
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "required": false,
      "default": 30,
      "min": 10,
      "max": 600,
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      }
    },
    {
      "key": "thresholds",
      "type": "section",
      "label": {
        "en": "Alert thresholds",
        "fr": "Seuils d'alerte"
      },
      "description": {
        "en": "A host alert is raised at the threshold and cleared 5 points below it.",
        "fr": "Une alerte est déclenchée au seuil et levée 5 points en dessous."
      }
    },
    {
      "key": "cpu_threshold",
      "type": "number",
      "required": false,
      "default": 95,
      "min": 10,
      "max": 100,
      "label": {
        "en": "CPU usage (%)",
        "fr": "Utilisation CPU (%)"
      }
    },
    {
      "key": "memory_threshold",
      "type": "number",
      "required": false,
      "default": 90,
      "min": 10,
      "max": 100,
      "label": {
        "en": "Memory usage (%)",
        "fr": "Utilisation mémoire (%)"
      }
    },
    {
      "key": "disk_threshold",
      "type": "number",
      "required": false,
      "default": 90,
      "min": 10,
      "max": 100,
      "label": {
        "en": "Disk usage (%)",
        "fr": "Utilisation disque (%)"
      }
    },
    {
      "key": "temperature_threshold",
      "type": "number",
      "required": false,
      "default": 85,
      "min": 30,
      "max": 120,
      "label": {
        "en": "CPU temperature (°C)",
        "fr": "Température CPU (°C)"
      }
    }
  ],
  "widgets": [
    {
      "key": "host",
      "label": {
        "en": "Linux host",
        "fr": "Machine Linux"
      },
      "description": {
        "en": "One host: CPU, memory, disk, temperature, swap and load gauges, plus status.",
        "fr": "Une machine : jauges CPU, mémoire, disque, température, swap et charge, plus état."
      },
      "icon": "server",
      "settings": [
        {
          "key": "host",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Host",
            "fr": "Machine"
          },
          "required": true
        }
      ]
    },
    {
      "key": "overview",
      "label": {
        "en": "Linux hosts",
        "fr": "Machines Linux"
      },
      "description": {
        "en": "Every host on one line, the ones needing attention first.",
        "fr": "Toutes les machines, une ligne chacune, celles à surveiller en premier."
      },
      "icon": "grid"
    }
  ],
  "scene_triggers": [
    {
      "key": "host_alert",
      "label": {
        "en": "Linux host alert",
        "fr": "Alerte machine Linux"
      },
      "description": {
        "en": "A host went down, crossed a threshold, has a failing drive or service — or is back to normal.",
        "fr": "Machine injoignable, seuil dépassé, disque ou service en échec — ou retour à la normale."
      },
      "fields": [
        {
          "key": "host",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Host (any when empty)",
            "fr": "Machine (toutes si vide)"
          }
        },
        {
          "key": "alert",
          "type": "multi_select",
          "label": {
            "en": "Alerts (any when empty)",
            "fr": "Alertes (toutes si vide)"
          },
          "options": [
            {
              "value": "unreachable",
              "label": {
                "en": "Host unreachable",
                "fr": "Machine injoignable"
              }
            },
            {
              "value": "cpu",
              "label": {
                "en": "CPU usage",
                "fr": "Utilisation CPU"
              }
            },
            {
              "value": "memory",
              "label": {
                "en": "Memory usage",
                "fr": "Utilisation mémoire"
              }
            },
            {
              "value": "disk",
              "label": {
                "en": "Disk usage",
                "fr": "Utilisation disque"
              }
            },
            {
              "value": "temperature",
              "label": {
                "en": "CPU temperature",
                "fr": "Température CPU"
              }
            },
            {
              "value": "drive",
              "label": {
                "en": "Drive health",
                "fr": "Santé des disques"
              }
            },
            {
              "value": "services",
              "label": {
                "en": "Failed services",
                "fr": "Services en échec"
              }
            },
            {
              "value": "reboot",
              "label": {
                "en": "Reboot required",
                "fr": "Redémarrage requis"
              }
            },
            {
              "value": "raid",
              "label": {
                "en": "RAID degraded",
                "fr": "RAID dégradé"
              }
            }
          ]
        },
        {
          "key": "status",
          "type": "select",
          "label": {
            "en": "Event (both when empty)",
            "fr": "Événement (les deux si vide)"
          },
          "options": [
            {
              "value": "raised",
              "label": {
                "en": "Alert raised",
                "fr": "Alerte déclenchée"
              }
            },
            {
              "value": "cleared",
              "label": {
                "en": "Back to normal",
                "fr": "Retour à la normale"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "host_name",
          "type": "string",
          "label": {
            "en": "Host name",
            "fr": "Nom de la machine"
          }
        },
        {
          "key": "alert",
          "type": "string",
          "label": {
            "en": "Alert key",
            "fr": "Clé de l'alerte"
          }
        },
        {
          "key": "alert_label",
          "type": "string",
          "label": {
            "en": "Alert",
            "fr": "Alerte"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "raised or cleared",
            "fr": "raised ou cleared"
          }
        },
        {
          "key": "value",
          "type": "number",
          "label": {
            "en": "Value",
            "fr": "Valeur"
          }
        },
        {
          "key": "detail",
          "type": "string",
          "label": {
            "en": "Detail",
            "fr": "Détail"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_host_status",
      "label": {
        "en": "Get Linux host status",
        "fr": "Lire l'état d'une machine Linux"
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "host",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Host (optional with a single host)",
            "fr": "Machine (facultatif s'il n'y en a qu'une)"
          }
        }
      ],
      "outputs": [
        {
          "key": "host_name",
          "type": "string",
          "label": {
            "en": "Host name",
            "fr": "Nom de la machine"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status",
            "fr": "État"
          }
        },
        {
          "key": "cpu",
          "type": "number",
          "label": {
            "en": "CPU usage (%)",
            "fr": "Utilisation CPU (%)"
          }
        },
        {
          "key": "memory",
          "type": "number",
          "label": {
            "en": "Memory usage (%)",
            "fr": "Utilisation mémoire (%)"
          }
        },
        {
          "key": "disk",
          "type": "number",
          "label": {
            "en": "Fullest disk (%)",
            "fr": "Disque le plus plein (%)"
          }
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "CPU temperature (°C)",
            "fr": "Température CPU (°C)"
          }
        },
        {
          "key": "uptime",
          "type": "string",
          "label": {
            "en": "Uptime",
            "fr": "Disponibilité"
          }
        },
        {
          "key": "updates",
          "type": "number",
          "label": {
            "en": "Updates pending",
            "fr": "Mises à jour en attente"
          }
        },
        {
          "key": "alerts",
          "type": "string",
          "label": {
            "en": "Alerts raised",
            "fr": "Alertes en cours"
          }
        }
      ]
    }
  ]
}
